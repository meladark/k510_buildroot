#!/bin/sh
# K510 launcher: runs the selected camera app (parking by default), touch menu,
# Wi-Fi setup AP, app switch page on :8080. Logs: /root/data/logs/.

PIDFILE=/var/run/launcher.pid
DAEMON=/app/launcher/launcher
LOG=/root/data/logs/launcher.log

start() {
	if start-stop-daemon -K -t -q -p $PIDFILE; then
		echo "launcher already running"
		return
	fi
	echo "starting launcher"
	mkdir -p /root/data/logs
	[ -f $LOG ] && [ $(stat -c %s $LOG) -gt 1000000 ] && mv -f $LOG $LOG.1
	export LD_LIBRARY_PATH=/lib:/usr/lib:/usr/local/lib
	start-stop-daemon -S -b -m -p $PIDFILE -x /bin/sh -- -c "exec $DAEMON >> $LOG 2>&1"
}

stop() {
	echo "stopping launcher"
	# the launcher stops the running app itself on SIGTERM
	start-stop-daemon -K -q -p $PIDFILE
	for i in $(seq 1 20); do
		start-stop-daemon -K -t -q -p $PIDFILE || { rm -f $PIDFILE; return 0; }
		sleep 1
	done
	start-stop-daemon -K -q -s KILL -p $PIDFILE
	rm -f $PIDFILE
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
